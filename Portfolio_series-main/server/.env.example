# Copy this file to `.env` (same folder) and fill in real values. `.env` is git-ignored — never commit it.

# MongoDB Atlas (or local) connection string. Create a database user with a strong password in Atlas
# and allow your server's IP under Network Access.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/portfolio?retryWrites=true&w=majority

# Port the API listens on
PORT=5000

# Comma-separated list of frontend origins allowed by CORS (no trailing slashes).
# Local dev uses Vite's default; add your deployed site's URL for production.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when the API runs behind a reverse proxy / PaaS (Render, Railway, ...) so rate limiting sees real client IPs.
TRUST_PROXY=0
